{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luckyray://companion/v1/qr-envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "name", "instance", "ip", "port", "secret", "fp"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "instance": { "type": "string", "pattern": "^desktop-[a-f0-9]{32}$" },
    "ip": { "type": "string", "pattern": "^(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "secret": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fp": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
