      "dsh-host/": "lr-lsh/199-1/dsh-host/",
      "media-engine/": "media-engine/",
      "../third-party-notices/": "third-party-notices/",
      "macos-lsh/host-support.mjs": "lr-lsh/199-1/dsh-host/luckyray-dsh-macos.mjs"
    }
  }
