#!/bin/sh
# LuckyRay deb: install and load the Agent Browser AppArmor profile (T55).
# Only where AppArmor ABI 4.0 (userns mediation) exists. If loading fails the
# package still installs and the Agent Browser fails closed with
# agent-browser-sandbox-unavailable; the sandbox is never disabled.
set -e
profile=luckyray-agent-browser
if [ "$1" = configure ] && [ -e /etc/apparmor.d/abi/4.0 ]; then
    install -m 0644 -o root -g root "/usr/share/luckyray/apparmor/$profile" "/etc/apparmor.d/$profile"
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
        apparmor_parser -r "/etc/apparmor.d/$profile" || true
    fi
fi
exit 0
