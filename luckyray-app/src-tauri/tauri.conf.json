{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuckyRay",
  "mainBinaryName": "luckyray-app",
  "version": "1.9.15",
  "identifier": "com.luckyray.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-frontend.mjs --reject-bare",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-tauri-build.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LuckyRay",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "dragDropEnabled": true,
        "decorations": false,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "dsh/": "deepseek-harness/",
      "dsh-host/": "dsh-host/",
      "media-engine/": "media-engine/"
    },
    "externalBin": [
      "binaries/luckyray-native-host",
      "binaries/luckyray-cli",
      "binaries/luckyray-mcp",
      "binaries/luckyray-browser-host"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/native-messaging-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
