{
  "name": "luckyray-app",
  "private": true,
  "version": "1.9.18",
  "license": "MIT",
  "author": "xiaorui2886 (xiaorui liang)",
  "type": "module",
  "scripts": {
    "test:desktop-signed-update": "node --experimental-strip-types --test tests/desktopUpdateInstall.test.mjs tests/desktopUpdateManifest.test.mjs",
    "release:update-manifest": "node scripts/build-desktop-update-manifest.mjs",
    "dev": "vite",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-luckyray-dev.ps1",
    "build": "npm run test:dsh-host-assets && tsc && vite build",
    "test:dsh-host-assets": "node --test tests/dshHostAssetBindings.contract.test.mjs",
    "preview": "vite preview",
    "test:workspace-store-binding": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/workspaceStoreBinding.contract.test.ts",
    "test:materials": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/materialStore.contract.test.ts",
    "test:material-catalog": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/materialCatalog.contract.test.ts",
    "test:material-missing": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/materialMissingRecovery.contract.test.ts",
    "test:material-library-move": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/materialLibraryMove.contract.test.ts",
    "test:folders": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/folderReloadCoordinator.contract.test.ts",
    "test:canvas-integration": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/canvasIntegration.contract.test.ts",
    "test:backend-bootstrap": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/backendBootstrap.contract.test.ts",
    "test:knowledge": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/knowledge.contract.test.ts",
    "test:knowledge-context": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/knowledgeContextCoordinator.contract.test.ts",
    "test:knowledge-consumers": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/knowledgeConsumers.contract.test.ts",
    "test:knowledge-db-retirement": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/knowledgeDbRetirement.contract.test.ts",
    "test:knowledge-capabilities": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/knowledgeCapabilities.contract.test.ts",
    "test:personal-browser": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/personalBrowser.contract.test.ts",
    "test:ai-conversation-safety": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/aiConversationSafety.contract.test.ts",
    "test:ai-model-profiles": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/aiModelProfiles.contract.test.ts",
    "test:agent-search-settings": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/agentSearchSettings.contract.test.ts",
    "test:settings-truth": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/settingsTruth.contract.test.ts",
    "test:experience-b2": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/experienceLayerB2.contract.test.ts",
    "test:sidebar-icons": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/appSidebarIcons.contract.test.ts",
    "test:favorites": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/favorites.contract.test.ts",
    "test:browser-host-poc": "cargo test --manifest-path src-tauri/Cargo.toml --features browser-host-poc,browser-host-poc-fixture --test browser_host_poc_contract -- --nocapture && cargo test --manifest-path src-tauri/Cargo.toml --release --features browser-host-poc,browser-host-poc-fixture --test browser_host_poc_contract release_fixture_mode_is_compiled_fail_closed -- --nocapture",
    "test:local-transport": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/localTransportAuth.contract.test.mjs tests/localTransportClient.contract.test.ts",
    "test:native-messaging": "node --experimental-strip-types --import ./tests/ts-extension-loader.mjs --test tests/nativeMessagingInstall.contract.test.ts",
    "test:package-readiness": "node --test tests/packageReadiness.contract.test.mjs",
    "test:extension-media": "node --test tests/extensionMediaCapture.contract.test.mjs tests/extensionPlayerMediaProbe.contract.test.mjs tests/extensionRecording.contract.test.mjs tests/extensionVideoDownload.contract.test.mjs",
    "test:dsh-supply-chain": "node scripts/run-dsh-supply-chain-gate.mjs",
    "test:dsh-supply-chain:unit": "node --test tests/dshSupplyChain.contract.test.mjs",
    "test:dsh-upgrade": "node scripts/run-dsh-upgrade-gate.mjs",
    "test:hermes-retirement": "node --test tests/hermesRetirement.contract.test.mjs",
    "test:extension-runtime": "node --test tests/browser-extension-runtime/runtime-fixture.contract.test.mjs",
    "test:extension-quick-collect": "node --test tests/extensionQuickCollect.contract.test.mjs",
    "test:extension-hover": "node --test tests/extensionHoverCapture.contract.test.mjs",
    "test:extension-video-flow": "node --test tests/extensionVideoFlow.contract.test.mjs",
    "build:sidecars": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-native-host.ps1",
    "build:native-host": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-native-host.ps1",
    "build:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-nsis.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "~2.4.0",
    "@xyflow/react": "^12.11.0",
    "d3-force": "3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/d3-force": "3.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
