{
  "manifest_version": 3,
  "name": "LuckyRay Collector",
  "version": "1.9.5",
  "version_name": "1.9.5 Main file/audio + capture receipts (20261010)",
  "key": "",
  "description": "Collect text, links, images, downloadable videos and direct MP3/WAV audio into LuckyRay.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications",
    "storage",
    "nativeMessaging",
    "tabCapture",
    "offscreen",
    "webRequest"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.pinterest.com/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "打开 LuckyRay 正文剪藏与网页截图"
    },
    "toggle-video-overlays": { "description": "显示或隐藏 LuckyRay 视频悬浮按钮" },
    "show-collector": { "description": "打开 LuckyRay 网页收集" },
    "collect-images": { "description": "选择网页中的多张图片" },
    "capture-visible": { "description": "截取当前网页可见区域" }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-media-probe.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "extension-protocol.js",
        "video-overlay-preference.js",
        "audio-collection.js",
        "appearance.js",
        "article-extractor.js",
        "page-capture.js",
        "image-collection.js",
        "content-script.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "LuckyRay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["extension-protocol.js", "offscreen.html", "offscreen.js", "capture.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
